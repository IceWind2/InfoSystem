<Window x:Class="InfoSystem.PatientMedicineModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Title="Лекарство пациента" Width="480" SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="7" BorderBrush="{StaticResource LineBrush}"
            Background="{StaticResource SurfaceBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="24,20,24,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="24,20,24,24">
                <TextBlock Text="Лекарство" Style="{StaticResource FieldLabel}"/>
                <ListBox Style="{StaticResource SelectionListBox}"
                         ItemsSource="{Binding Medicines}"
                         SelectedItem="{Binding SelectedMedicine}"
                         Height="148" FontSize="16"
                         DisplayMemberPath="Name"/>
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding MedicineError}"/>

                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Предписание" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource NoteBox}"
                             Text="{Binding Prescription, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16"/>
                </StackPanel>

                <TextBlock Text="Заметки" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <TextBox Style="{StaticResource NoteBox}"
                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16"/>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="24,12,24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" IsCancel="True" Height="36" Padding="18,0" Margin="0,0,8,0"/>
                    <Button Content="Добавить" IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            Height="36" Padding="18,0" Margin="0"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
