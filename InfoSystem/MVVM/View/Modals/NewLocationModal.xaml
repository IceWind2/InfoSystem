<Window x:Class="InfoSystem.NewLocationModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Title="Адрес" Width="420" SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="7" BorderBrush="{StaticResource LineBrush}"
            Background="{StaticResource SurfaceBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Margin="24,20,24,0" Text="{Binding Title}" Style="{StaticResource PageTitle}"/>

            <StackPanel Grid.Row="1" Margin="24,20,24,24">
                <TextBlock Text="Название адреса" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FormBox}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16"/>
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding NameError}"/>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="24,12,24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" IsCancel="True" Height="36" Padding="18,0" Margin="0,0,8,0"/>
                    <Button Content="Сохранить" IsDefault="True" Style="{StaticResource PrimaryButton}"
                            Height="36" Padding="18,0" Margin="0" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
