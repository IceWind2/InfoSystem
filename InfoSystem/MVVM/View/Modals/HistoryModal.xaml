<Window x:Class="InfoSystem.HistoryModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Title="История пациента"
        Width="900" Height="560"
        MinWidth="720" MinHeight="420"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="7" BorderBrush="{StaticResource LineBrush}"
            Background="{StaticResource SurfaceBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="24,20,24,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Записи о действиях и изменениях" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>

            <ContentControl Grid.Row="1" Content="{Binding HistoryView}"/>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="24,12,24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Закрыть" IsCancel="True" IsDefault="True"
                            Height="36" Padding="18,0" Margin="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
