<Window x:Class="InfoSystem.NewPatientModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InfoSystem"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Title="Новый пациент" Width="480" SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:EnumToBoolConverter x:Key="sexTypeConverter"/>

        <!-- Toggle button for sex -->
        <Style x:Key="ToggleOption" TargetType="RadioButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="18"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TintBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Location list -->
        <Style x:Key="LocationList" TargetType="ListBox">
            <Setter Property="Height" Value="148"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="4" Padding="10,4" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TintBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="7"
            BorderBrush="{StaticResource LineBrush}"
            Background="{StaticResource SurfaceBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="24,20,24,0">
                <TextBlock Text="Новый пациент" Style="{StaticResource PageTitle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="24,16,24,8">
                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="ФИО"/>
                </TextBlock>
                <TextBox Style="{StaticResource FormBox}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" FontSize="16"/>
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding FullNameError}"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="Дата рождения"/>
                        </TextBlock>
                        <DatePicker Height="36" VerticalContentAlignment="Center"
                                    FontSize="18"
                                    
                                    SelectedDateFormat="Short"
                                    SelectedDate="{Binding BirthDate}"/>
                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding BirthDateError}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}">
                         <Run Text="Пол"/>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton GroupName="sex" Content="Ж" Style="{StaticResource ToggleOption}"
                                     IsChecked="{Binding Sex, Converter={StaticResource sexTypeConverter}, ConverterParameter={x:Static local:Sex.Female}}"/>
                            <RadioButton Grid.Column="2" GroupName="sex" Content="М" Style="{StaticResource ToggleOption}"
                                     IsChecked="{Binding Sex, Converter={StaticResource sexTypeConverter}, ConverterParameter={x:Static local:Sex.Male}}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldError}" Text="{Binding SexError}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,6">
                <Run Text="Адрес"/>
                </TextBlock>
                <ListBox Style="{StaticResource LocationList}"
                         ItemsSource="{Binding Locations}"
                         SelectedItem="{Binding SelectedLocation}"
                         FontSize="18"/>
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding LocationsError}"/>

                <Grid Margin="0,16,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Диагноз" Style="{StaticResource FieldLabel}" Margin="0"/>
                    <Button Grid.Column="1" Content="Очистить" Height="26" Padding="10,0" Margin="0"
                            Command="{Binding ClearDiagnosisCommand}"/>
                </Grid>
                <ListBox Style="{StaticResource LocationList}"
                         Height="100"
                         ItemsSource="{Binding Diagnoses}"
                         SelectedItem="{Binding SelectedDiagnosis}"
                         FontSize="18"/>

                <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <TextBox Style="{StaticResource NoteBox}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" FontSize="16"/>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="24,12,24,20" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" IsCancel="True" Height="36" Padding="18,0" Margin="0,0,8,0"/>
                    <Button Content="Сохранить" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        Height="36" Padding="18,0" Margin="0" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
