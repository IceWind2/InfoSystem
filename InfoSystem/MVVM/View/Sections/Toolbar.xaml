<UserControl x:Class="InfoSystem.Toolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:InfoSystem"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                 Width="280"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        <Button Grid.Column="1" Content="Фильтр" Margin="8,0,0,0" Command="{Binding FilterCommand}"/>

        <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"
                   Text="{Binding TotalCount, StringFormat=Всего: {0}}"/>

        <StackPanel Grid.Column="4" Orientation="Horizontal">
            <Button Content="Изменить" Command="{Binding EditCommand}"
              Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}"
              Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
            <Button Content="+ Добавить" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
              Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
