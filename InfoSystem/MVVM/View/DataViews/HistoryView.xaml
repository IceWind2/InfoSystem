<UserControl x:Class="InfoSystem.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InfoSystem"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <DataGrid x:Name="HistoryTable" ItemsSource="{Binding History}" Margin="24,16,24,20">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Дата" Width="180"
                                Binding="{Binding LocalTime, StringFormat=HH:mm dd-MM-yyyy}"/>
            <DataGridTextColumn Header="Действие" Width="220" Binding="{Binding Change}"/>
            <DataGridTextColumn Header="Заметки" Width="*" Binding="{Binding Note}"/>
            <DataGridTemplateColumn Width="60" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Button Width="20" Height="20" Padding="0" Margin="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="Удалить запись"
                                Command="{Binding DataContext.RemoveHistoryCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                CommandParameter="{Binding}">
                            <Grid Width="20" Height="20">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="#FF3B40"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                             Value="True">
                                                    <Setter Property="Fill" Value="#D9262E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Path Data="M 6,6 L 14,14 M 14,6 L 6,14"
                                      Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
